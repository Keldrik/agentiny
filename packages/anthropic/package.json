{
  "name": "@agentiny/anthropic",
  "version": "0.2.0",
  "description": "Anthropic Claude adapter for @agentiny/core",
  "repository": "https://github.com/Keldrik/agentiny",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "keywords": [
    "agent",
    "anthropic",
    "adapter",
    "llm",
    "claude"
  ],
  "author": "Thomas Wiegold",
  "license": "MIT",
  "peerDependencies": {
    "@agentiny/core": "*",
    "@anthropic-ai/sdk": ">=0.67.0 <1.0.0",
    "zod": "^3.25 || ^4.0"
  },
  "peerDependenciesMeta": {
    "@agentiny/core": {
      "optional": false
    },
    "@anthropic-ai/sdk": {
      "optional": false
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@agentiny/core": "*",
    "@anthropic-ai/sdk": "^0.117.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
